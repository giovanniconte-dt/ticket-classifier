# Configurazione SQL Server
# Scegli UNO dei due metodi di autenticazione

# Metodo 1: Windows Authentication (Trusted Connection)
# Usa questo se hai accesso Windows al database
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER=localhost
SQL_DATABASE=nome_database
SQL_TRUSTED_CONNECTION=yes

# Metodo 2: SQL Server Authentication
# Usa questo se hai username e password SQL Server
# SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server
# SQL_SERVER=localhost
# SQL_DATABASE=nome_database
# SQL_USERNAME=tuo_username
# SQL_PASSWORD=tua_password
# SQL_TRUSTED_CONNECTION=no

# Configurazione LLM (Ollama)
# Modello da utilizzare (default: llama3.2:3b)
LLM_MODEL=llama3.2:3b

# Temperature per il modello (0 = deterministico, valori più alti = più creativo)
# Per classificazione, consigliato 0
LLM_TEMPERATURE=0

# Base URL di Ollama (opzionale, default: http://localhost:11434)
# Modifica solo se Ollama è su un server diverso
# LLM_BASE_URL=http://localhost:11434
